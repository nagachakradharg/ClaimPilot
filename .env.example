# Copy to .env and adjust. Never commit .env.

ENV=dev
DATABASE_URL=postgresql+psycopg://claimpilot:claimpilot@localhost:5432/claimpilot

# --- LLM tier (zero-cost ladder, requirements §7) -----------------------------
# fake   : canned responses, no network (default; tests + CI + UI work)
# replay : serve responses recorded earlier; a miss is an error
# record : call the real model and save responses for replay
# live   : call the real model, save nothing
LLM_MODE=fake

# "provider:model". Local default needs `ollama pull gpt-oss:20b`.
# Paid examples (verify current model names before use):
#   LLM_DEFAULT_MODEL=openai:<model-name>
#   LLM_DEFAULT_MODEL=anthropic:<model-name>
LLM_DEFAULT_MODEL=ollama:gpt-oss:20b
# Per-node overrides (JSON). Vision steps need a multimodal model.
# LLM_NODE_MODELS={"intake": "openai:<vision-model>", "fraud_photo": "openai:<vision-model>"}
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2

# Provider keys (only for record/live with a paid provider; set a spend cap at the provider)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Review gate thresholds ---------------------------------------------------
FRAUD_REVIEW_THRESHOLD=0.6
PAYOUT_REVIEW_THRESHOLD=5000
EXTRACTION_CONFIDENCE_MIN=0.7

# --- Tracing (optional; Langfuse Cloud free tier or self-hosted) -------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

CORS_ORIGINS=["http://localhost:5173"]
