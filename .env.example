# Copy to .env and adjust. Never commit .env.

ENV=dev
DATABASE_URL=postgresql+psycopg://claimpilot:claimpilot@localhost:5432/claimpilot

# --- LLM tier (zero-cost ladder, requirements §7) -----------------------------
# fake   : canned responses, no network (default; tests + CI + UI work)
# replay : serve responses recorded earlier; a miss is an error
# record : call the real model and save responses for replay
# live   : call the real model, save nothing
LLM_MODE=fake

# "provider:model". Local default (text + vision) needs `ollama pull gemma4:12b`.
# Paid examples (verify current model names before use):
#   LLM_DEFAULT_MODEL=openai:<model-name>
#   LLM_DEFAULT_MODEL=anthropic:<model-name>
LLM_DEFAULT_MODEL=ollama:gemma4:12b
# Per-node overrides (JSON). Vision steps need a multimodal model.
# LLM_NODE_MODELS={"intake": "openai:<vision-model>", "fraud_photo": "openai:<vision-model>"}
# Ollama thinking control: false | true | low | medium | high (unset = model default)
LLM_REASONING=false
LLM_TIMEOUT_S=120
LLM_MAX_RETRIES=2

# Provider keys (only for record/live with a paid provider; set a spend cap at the provider)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Review gate thresholds ---------------------------------------------------
FRAUD_REVIEW_THRESHOLD=0.6
PAYOUT_REVIEW_THRESHOLD=5000
EXTRACTION_CONFIDENCE_MIN=0.7

# --- Tracing (optional; Langfuse Cloud free tier or self-hosted) -------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com   # EU; US region: https://us.cloud.langfuse.com
# TRACING=false   # kill switch: keeps keys but sends nothing (tests always set this)

# --- Auth ----------------------------------------------------------------------
# Required outside local dev: a long random value (e.g. `openssl rand -hex 32`).
# JWT_SECRET=
# Password for the seeded demo users (synthetic data). Change for any shared deployment.
# DEMO_PASSWORD=claimpilot-demo

# --- Cost + impact dashboard ------------------------------------------------------
# USD per 1M tokens [input, output] per model; unlisted models (local) cost 0.
# MODEL_PRICES={"openai:<model>": [0.15, 0.60]}
MANUAL_HANDLING_MINUTES=45

CORS_ORIGINS=["http://localhost:5173"]
