# Rendered by the nginx image at start (envsubst): API_UPSTREAM, DNS_RESOLVER.
server {
  listen 80;
  root /usr/share/nginx/html;
  client_max_body_size 64m;   # up to 6 photos x 10 MB

  # Re-resolve the API name so a restarted/rescheduled API container is found again.
  resolver ${DNS_RESOLVER} valid=10s ipv6=off;
  set $api_upstream ${API_UPSTREAM};

  location /api/ {
    rewrite ^/api/(.*)$ /$1 break;        # strip the /api prefix
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Server-sent events: no buffering, long reads
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;
  }

  location / {
    try_files $uri /index.html;           # client-side routes
  }
}
